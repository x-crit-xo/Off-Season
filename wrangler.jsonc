{
  // 1) Must match your Worker's name in the Cloudflare dashboard exactly.
  "name": "off-season",
  "main": "worker.js",
  "compatibility_date": "2026-11-01",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      // 2) Your D1 database's name and ID (Storage & databases > D1 > your database).
      "database_name": "off-season",
      "database_id": "6d5ed38c-e609-4715-b835-d27175b29990"
    }
  ]
}
